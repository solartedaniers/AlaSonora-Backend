# Formato: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres (vacío = contextLoads se salta)
DB_URL=
DB_USERNAME=postgres.<tu-project-ref>
DB_PASSWORD=
SUPABASE_JWKS_URI=https://<tu-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Admin API (panel de administración: alta y suspensión de usuarios)
# service_role key, NUNCA la anon key — Project Settings > API en el dashboard de Supabase.
SUPABASE_URL=https://<tu-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Motor de IA: servicio aparte (repo AlaSonora-IA); en local corre con uvicorn en el puerto 8000
AI_ENGINE_BASE_URL=http://localhost:8000
AI_ENGINE_API_KEY=<mismo valor que INTERNAL_API_KEY en el .env del motor de IA>

# Xeno-canto: tipos de vocalización de referencia por especie (clave gratuita en xeno-canto.org)
XENO_CANTO_API_KEY=
