DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<tu-project-ref>
DB_PASSWORD=
SUPABASE_JWKS_URI=https://<tu-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Admin API (panel de administración: alta y suspensión de usuarios)
# service_role key, NUNCA la anon key — Project Settings > API en el dashboard de Supabase.
SUPABASE_URL=https://<tu-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AI engine (ai-engine/, run separately with uvicorn)
AI_ENGINE_BASE_URL=http://localhost:8000
AI_ENGINE_API_KEY=<mismo valor que INTERNAL_API_KEY en ai-engine/.env>
